{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:security": "vitest run src/tests/securityPredicates.vitest.test.ts && tsx --test src/tests/security.test.ts tests/securityRegression.test.ts",
    "test:unit": "vitest run src/tests/projectStateTransitions.vitest.test.tsx src/tests/prismHologramAcceptance.vitest.test.tsx src/tests/sourceManifestConsistency.vitest.test.ts src/tests/windmillContracts.vitest.test.ts src/tests/sourceAuthoringAndHandoff.vitest.test.tsx",
    "test": "npm run test:security && npm run test:unit && tsx --test src/tests/offlineReliability.test.ts",
    "test:e2e": "playwright test",
    "windmill:prepare": "node scripts/prepare-windmill-app.mjs",
    "windmill:validate": "node scripts/prepare-windmill-app.mjs --verify",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
